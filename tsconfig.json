{
  "include": [
    "src/**/*",
    "tests/**/*",
    "main.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "checkJs": true,
    "allowJs": true,
    // Для UserScripts (важно)
    "noEmit": true,
    "isolatedModules": true,
    // Удобно для VSCode + Continue
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  }
}