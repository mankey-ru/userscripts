{
  "include": [
    "scripts/**/*",
    "main.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "scripts/**/*.test.ts"
  ],
  "compilerOptions": {
    "types": ["tampermonkey"],
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "checkJs": true,
    "allowJs": true,
    // Для UserScripts (важно)
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  }
}
